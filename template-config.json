{
  "services": {
    "baa25ffb-adc4-4073-b788-71ac82984818": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/nextcloud.svg",
      "name": "Nextcloud",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/status.php",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/two-workspaces/nextcloud:01351a7"
      },
      "variables": {
        "PORT": {
          "defaultValue": "80",
          "description": "Port Apache listens on - leave as is",
          "isOptional": false
        },
        "NEXTCLOUD_ADMIN_USER": {
          "defaultValue": "admin",
          "description": "Admin username, created on first boot",
          "isOptional": false
        },
        "NEXTCLOUD_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Admin password, set on first boot only - copy it from here to log in, then change it in Nextcloud",
          "isOptional": false
        },
        "NEXTCLOUD_TRUSTED_DOMAINS": {
          "defaultValue": "${{RAILWAY_PUBLIC_DOMAIN}} healthcheck.railway.app",
          "description": "Domains Nextcloud answers on, set on first boot (the second is Railway's healthcheck) - add your custom domain with occ afterwards",
          "isOptional": false
        },
        "OVERWRITEPROTOCOL": {
          "defaultValue": "https",
          "description": "Railway terminates TLS in front of Nextcloud - leave as is",
          "isOptional": false
        },
        "OVERWRITECLIURL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "URL used in links from background jobs and emails",
          "isOptional": false
        },
        "TRUSTED_PROXIES": {
          "defaultValue": "100.64.0.0/10",
          "description": "Railway's proxy range, so Nextcloud sees real client IPs - leave as is",
          "isOptional": false
        },
        "POSTGRES_HOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres host - private network, leave as is",
          "isOptional": false
        },
        "POSTGRES_DB": {
          "defaultValue": "${{Postgres.POSTGRES_DB}}",
          "description": "Postgres database - leave as is",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "${{Postgres.POSTGRES_USER}}",
          "description": "Postgres user - leave as is",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
          "description": "Postgres password - leave as is",
          "isOptional": false
        },
        "REDIS_HOST": {
          "defaultValue": "${{Redis.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Redis for file locking and caching - private network, leave as is",
          "isOptional": false
        },
        "REDIS_HOST_PASSWORD": {
          "defaultValue": "${{Redis.REDIS_PASSWORD}}",
          "description": "Redis password - leave as is",
          "isOptional": false
        },
        "PHP_MEMORY_LIMIT": {
          "defaultValue": "512M",
          "description": "PHP memory limit per request",
          "isOptional": false
        },
        "PHP_UPLOAD_LIMIT": {
          "defaultValue": "10G",
          "description": "Largest single upload through the browser (the desktop and mobile apps upload in chunks)",
          "isOptional": false
        },
        "RAILWAY_HEALTHCHECK_TIMEOUT_SEC": {
          "defaultValue": "600",
          "description": "The first boot copies Nextcloud onto the volume and installs it before serving",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "baa25ffb-adc4-4073-b788-71ac82984818": {
          "mountPath": "/var/www/html"
        }
      }
    },
    "006f0307-ac3b-496d-8e2e-92266c999c66": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "Postgres",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18"
      },
      "variables": {
        "POSTGRES_DB": {
          "defaultValue": "nextcloud",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "nextcloud",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for Postgres to shut down cleanly on redeploy",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "006f0307-ac3b-496d-8e2e-92266c999c66": {
          "mountPath": "/var/lib/postgresql/data"
        }
      }
    },
    "90da150d-1e57-4612-aa07-5262d9613cd6": {
      "icon": "https://devicons.railway.app/i/redis.svg",
      "name": "Redis",
      "build": {},
      "deploy": {
        "startCommand": "/bin/sh -c \"exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --save '' --appendonly no\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "redis:8.10.2-alpine"
      },
      "variables": {
        "REDIS_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated Redis password",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      }
    }
  }
}
